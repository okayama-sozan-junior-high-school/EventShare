# Copy to .dev.vars for local development (never commit .dev.vars).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret

# Groq API key (https://console.groq.com/keys). Required when AI_PROVIDER=groq.
# GROQ_API_KEY=

# Only needed when AI_PROVIDER=openai (OpenAI-compatible Chat Completions API).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. When set, the MCP endpoint (/mcp) requires
# "Authorization: Bearer <token>". Unset = no auth (read-only tools).
# Rate limiting uses the RL_MCP binding in wrangler.jsonc.
# MCP_ACCESS_TOKEN=
