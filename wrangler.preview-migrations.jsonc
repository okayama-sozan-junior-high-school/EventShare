/**
 * Apply D1 migrations to the shared Preview database.
 * `wrangler preview` reads bindings from wrangler.jsonc `env.production.previews`,
 * but `d1 migrations apply` only sees top-level `d1_databases`.
 *
 * npm run db:migrate:preview
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-share-preview-migrations",
	"compatibility_date": "2026-10-23",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "event-share-preview",
			"database_id": "4c08598a-3cf0-4a52-be81-b296e579e9e7",
			"migrations_dir": "drizzle/migrations"
		}
	]
}
